{
  "name": "dsh-session-triage",
  "version": "0.5.1",
  "private": true,
  "description": "DSH Web 会话看板：未读标记、红黄绿处理状态、跨工作区总览，支持可改键快捷键。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "session",
    "unread",
    "triage",
    "web"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huihui308/dsh-session-triage.git"
  },
  "homepage": "https://github.com/huihui308/dsh-session-triage#readme",
  "bugs": {
    "url": "https://github.com/huihui308/dsh-session-triage/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
